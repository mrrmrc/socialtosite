# Copia questo file in .env sul server. Non commettere mai .env.
APP_PORT=8081
APP_BIND_ADDRESS=0.0.0.0
BASE_URL=http://213.32.22.252:8081
ALLOWED_ORIGIN=http://213.32.22.252:8081

# Frequenza del controllo automatico dei profili attivi (21600 = 6 ore).
# Il valore minimo accettato è 300 secondi.
SYNC_INTERVAL_SECONDS=21600

LINKSEOWEB_DB_NAME=linkseoweb
LINKSEOWEB_DB_USER=linkseoweb
LINKSEOWEB_DB_PASSWORD=sostituisci_con_password_lunga
LINKSEOWEB_DB_ROOT_PASSWORD=sostituisci_con_altra_password_lunga

# Genera ciascun valore con: openssl rand -hex 32
JWT_SECRET=sostituisci_con_64_caratteri_esadecimali
ANALYTICS_SALT=sostituisci_con_64_caratteri_esadecimali

# Servizi AI (lascia vuoto ciò che non usi)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Acquisizione server-side dei contenuti social pubblici
REFETCHER_API_KEY=

# Integrazioni opzionali
OPENCLAW_API_KEY=
GSC_PROPERTY=
