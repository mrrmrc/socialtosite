# .htaccess — Routing Apache per SocialToSite (carica nella root del dominio)

RewriteEngine On

# ── Passa l'header Authorization a PHP (necessario per il JWT) ──────────────
# Su molti hosting condivisi l'header Authorization non arriva a PHP:
# queste righe lo rendono disponibile in $_SERVER['HTTP_AUTHORIZATION'].
RewriteCond %{HTTP:Authorization} ^(.+)$
RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

# ── robots.txt per SEO ──────────────────────────────────────────────────────
RewriteRule ^robots\.txt$ robots.txt [L]

# ── Sito pubblico ───────────────────────────────────────────────────────────
# Sitemap globale
RewriteRule ^sitemap\.xml$ public/sitemap.php [L,QSA]

# Sitemap, Feed, e llms.txt
RewriteRule ^s/([^/]+)/sitemap\.xml$ public/site.php?slug=$1&action=sitemap [L,QSA]
RewriteRule ^s/([^/]+)/feed\.xml$ public/site.php?slug=$1&action=feed [L,QSA]
RewriteRule ^s/([^/]+)/llms\.txt$ public/site.php?slug=$1&action=llms [L,QSA]

# Pagina pubblica:  /s/<slug>  e  /s/<slug>/<post-slug>
RewriteRule ^s/([^/]+)/?$ public/site.php?slug=$1 [L,QSA]
RewriteRule ^s/([^/]+)/([^/]+)/?$ public/site.php?slug=$1&post=$2 [L,QSA]

# ── Sicurezza: blocca accesso diretto a file sensibili ─────────────────────
<FilesMatch "(?i)(config\.php|keys\.php|.*\.env|.*\.sql|.*\.example\.php)$">
  Require all denied
</FilesMatch>

# Niente listing delle cartelle
Options -Indexes
