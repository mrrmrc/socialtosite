# .htaccess — Routing Apache per SocialToSite (carica nella root del dominio)

RewriteEngine On

# ── Passa l'header Authorization a PHP (necessario per il JWT) ──────────────
# Su molti hosting condivisi l'header Authorization non arriva a PHP:
# queste righe lo rendono disponibile in $_SERVER['HTTP_AUTHORIZATION'].
RewriteCond %{HTTP:Authorization} ^(.+)$
RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

# ── robots.txt per SEO ──────────────────────────────────────────────────────
RewriteRule ^robots\.txt$ robots.txt [L]

# ── Sito pubblico ───────────────────────────────────────────────────────────
# Sitemap globale
RewriteRule ^sitemap\.xml$ public/sitemap.php [L,QSA]

# Hub editoriale del dominio padre: collega e rende scopribili tutti i siti
RewriteRule ^scopri/sitemap\.xml$ public/discover.php?action=sitemap [L,QSA]
RewriteRule ^scopri/tema/([^/]+)/?$ public/discover.php?topic=$1 [L,QSA]
RewriteRule ^scopri/?$ public/discover.php [L,QSA]

# Sitemap, Feed, e llms.txt
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/(api|cron|db|frontend|public|node_modules|assets|login|dashboard|connect|generating|scopri) [NC]
RewriteRule ^([^/]+)/sitemap\.xml$ public/site.php?slug=$1&action=sitemap [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/(api|cron|db|frontend|public|node_modules|assets|login|dashboard|connect|generating|scopri) [NC]
RewriteRule ^([^/]+)/feed\.xml$ public/site.php?slug=$1&action=feed [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/(api|cron|db|frontend|public|node_modules|assets|login|dashboard|connect|generating|scopri) [NC]
RewriteRule ^([^/]+)/llms\.txt$ public/site.php?slug=$1&action=llms [L,QSA]

# Pagina pubblica:  /<slug>  e  /<slug>/<post-slug>
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/(api|cron|db|frontend|public|node_modules|assets|login|dashboard|connect|generating|scopri) [NC]
RewriteRule ^([^/]+)/categoria/([^/]+)/?$ public/site.php?slug=$1&tag=$2 [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/(api|cron|db|frontend|public|node_modules|assets|login|dashboard|connect|generating|scopri) [NC]
RewriteRule ^([^/]+)/?$ public/site.php?slug=$1 [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/(api|cron|db|frontend|public|node_modules|assets|login|dashboard|connect|generating|scopri) [NC]
RewriteRule ^([^/]+)/([^/]+)/?$ public/site.php?slug=$1&post=$2 [L,QSA]

# ── Sicurezza: blocca accesso diretto a file sensibili ─────────────────────
<FilesMatch "(?i)(config\.php|keys\.php|.*\.env|.*\.sql|.*\.example\.php)$">
  Require all denied
</FilesMatch>

# Script di servizio: non devono mai essere raggiungibili dal web, nemmeno se
# per errore finissero nella release. La difesa principale è la lista di
# inclusione nel workflow di deploy: questa è la seconda barriera.
<FilesMatch "(?i)^(.*(debug|diagnostic|migrat|phpinfo).*|check[-_].*|.*[-_]check|test[-_].*|.*[-_]test|reset-.*|puppet|scraper)\.(php|js|py|txt|jsx|html)$">
  Require all denied
</FilesMatch>

# File di appoggio e residui di editor: mai serviti.
# (deploy-info.json resta accessibile: la dashboard lo legge per mostrare
# quale release è online.)
<FilesMatch "(?i)\.(log|bak|old|orig|swp|md|py)$">
  Require all denied
</FilesMatch>

# Niente listing delle cartelle
Options -Indexes

# ── Cache: index.html sempre fresco, asset hashati immutabili ───────────────
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2?|ttf|png|jpg|jpeg|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ── Asset buildati: MAI fallback SPA ───────────────────────────────────────
# Un file sotto /assets/ che non esiste deve dare 404, NON index.html.
# Altrimenti (es. durante un deploy) il browser riceve HTML al posto del JS,
# lo mette in cache e va in "Failed to load module script (MIME text/html)".
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^assets/ - [R=404,L]

# ── SPA Fallback (React Router) ─────────────────────────────────────────────
# Se il file o la directory richiesta non esiste, redirigi tutto a index.html
# in modo che React Router possa gestire la rotta lato client (es. /dashboard)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
